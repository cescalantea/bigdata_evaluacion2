# Copie este archivo como .env y complete la URI de MongoDB Atlas.
# Si la contrasena contiene @, :, / u otros caracteres especiales, codifiquela en URL.
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster.example.mongodb.net/bigdata_eval3
MONGODB_DB=bigdata_eval3
MONGODB_COLLECTION_CSV=datos_csv
MONGODB_BATCH_SIZE=10000
MONGODB_TIMEOUT_MS=15000
MONGODB_MAX_ATTEMPTS=3
MONGODB_RETRY_DELAY=2

# Configuracion del socket del servidor.
SERVIDOR_HOST=127.0.0.1
SERVIDOR_PUERTO=12345
SERVIDOR_PUERTO_SENSORES=12346

# Neon PostgreSQL (dejar DATABASE_URL vacia para deshabilitar).
DATABASE_URL=
# Ejemplo: postgresql://usuario:password@host.neon.tech/neondb?sslmode=require
POSTGRES_BATCH_SIZE=10000
POSTGRES_CONNECT_TIMEOUT=15
POSTGRES_STATEMENT_TIMEOUT_MS=300000
